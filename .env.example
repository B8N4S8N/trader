# -----------------------------------------------------------------------------
# Shared environment variables. Copy to `.env` and fill in real values.
# NEVER commit a real `.env`. Secrets belong in your host's secret manager.
# -----------------------------------------------------------------------------

# Postgres connection used by Prisma (db package) and both apps.
DATABASE_URL="postgresql://trader:trader@localhost:5432/traderdb?schema=public"

# -----------------------------------------------------------------------------
# Private trading agent configuration (apps/agent)
# -----------------------------------------------------------------------------

# Execution mode: "paper" (simulated, safe default) or "live" (real Robinhood).
# LIVE trading requires TRADER_ALLOW_LIVE=true AND a connected Robinhood MCP.
TRADER_MODE="paper"
TRADER_ALLOW_LIVE="false"

# Agent loop cadence in milliseconds (simulated market tick).
AGENT_TICK_MS="3000"

# Starting paper cash balance (USD).
AGENT_STARTING_CASH="100000"

# Comma-separated universe of symbols the agent may analyze/trade.
AGENT_SYMBOLS="AAPL,MSFT,NVDA,TSLA,AMZN,SPY"

# --- Risk guardrails (enforced client-side before any order leaves the agent) --
RISK_MAX_ORDER_NOTIONAL="10000"     # Max $ per single order
RISK_MAX_DAILY_ORDERS="200"         # Max orders per UTC day
RISK_MAX_POSITION_PCT="0.25"        # Max fraction of equity in one symbol
RISK_MAX_GROSS_EXPOSURE_PCT="1.0"   # Max fraction of equity deployed at once
RISK_KILL_SWITCH="false"            # Set true to halt ALL order placement

# -----------------------------------------------------------------------------
# Robinhood Trading MCP (LIVE mode only — connect on YOUR private host)
# https://agent.robinhood.com/mcp/trading  (OAuth 2.1 + PKCE, browser approval)
# The agent never stores your password; the OAuth token lives in your host's
# credential store. Leave blank in paper mode.
# -----------------------------------------------------------------------------
ROBINHOOD_MCP_URL="https://agent.robinhood.com/mcp/trading"
